# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Número del admin/director de campaña (con código de país, sin + ni espacios)
ADMIN_NUMBER=59894032474

# Para conectar por código en vez de QR, pone el número del bot acá (con código de país, sin + ni espacios)
# Si lo dejás vacío o comentado, usa QR como siempre
# PAIRING_NUMBER=5491112345678

# Puerto del servidor
PORT=3000

# Nombre del estudio de marketing
FIRM_NAME=Estudio de Marketing

# Nombre del candidato (se usa en el prompt de la IA y en los mensajes de difusión)
CANDIDATE_NAME=Juan Pérez

# Información de campaña (propuesta, posición política, datos biográficos)
# También se puede configurar desde el panel admin opción 6
CAMPAIGN_INFO=Candidato a intendente por el partido X. Propuesta enfocada en seguridad y empleo.

# Hora UTC en que se envía la difusión diaria (por defecto 12 = 9:00 AM Argentina UTC-3)
BROADCAST_HOUR_UTC=12

# Clave para proteger los endpoints /api/* en testing local (opcional, si no se configura quedan abiertos)
# API_SECRET=mi_clave_secreta
